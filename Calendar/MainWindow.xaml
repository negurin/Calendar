<Window x:Class="Calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Calendar"
        Title="Календарь"
        Height="622" Width="541"
        MinHeight="622" MinWidth="541"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource WindowFg}" Icon="/calendar.ico">

    <Window.Resources>
        <!-- Единый стиль для всех кнопок панели -->
        <Style TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource WindowFg}"/>
            <Setter Property="Padding"     Value="9,4"/>
            <Setter Property="Margin"      Value="3"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="◀" Click="PrevPeriod_Click"/>

            <Border x:Name="PeriodContainer" Background="Transparent" Cursor="Arrow"
                    Padding="6,2" Margin="4,0" MouseLeftButtonUp="PeriodContainer_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PeriodLabel"
                   FontSize="17" FontWeight="Bold"
                   VerticalAlignment="Center"
                   MinWidth="140" TextAlignment="Center"/>
                    <TextBlock x:Name="PeriodChevron"
                   Text="▼"
                   FontSize="10"
                   VerticalAlignment="Center"
                   Margin="6,4,0,0"
                   Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Button Content="▶" Click="NextPeriod_Click"/>

            <Button x:Name="ViewToggleButton" Content="Месяц" Click="ViewToggleButton_Click"
                    Margin="15,3,3,3" MinWidth="70"/>
            <Button x:Name="TodayButton" Content="Сегодня" Click="TodayButton_Click"
                    ToolTip="Перейти к сегодняшнему дню" Margin="3"/>

            <Button x:Name="ThemeButton" Content="🌙"
                    Click="ThemeButton_Click"
                    ToolTip="Переключить тему" Margin="15,3,3,3"/>
        </StackPanel>

        <!-- Вид "Год" — сетка 3×4 -->
        <UniformGrid x:Name="YearGrid" Grid.Row="1" Columns="3"/>

        <!-- Вид "Месяц" — тот же контрол, растянутый по всей области -->
        <local:MonthView x:Name="SingleMonthView" Grid.Row="1"
                         Visibility="Collapsed"/>

        <Popup x:Name="YearPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" VerticalOffset="4">
            <Border Background="{DynamicResource MonthBg}" BorderBrush="{DynamicResource MonthBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Content="◀◀" Padding="6,2"
                        Click="YearPagePrev_Click"/>
                        <TextBlock x:Name="YearRangeLabel"
                           FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center"
                           Margin="12,0" MinWidth="110"
                           TextAlignment="Center"/>
                        <Button Content="▶▶" Padding="6,2"
                        Click="YearPageNext_Click"/>
                    </StackPanel>
                    <UniformGrid x:Name="YearPopupGrid" Columns="4" Rows="3"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>